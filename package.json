{
  "name": "s-cyber-sage",
  "version": "0.1.0",
  "description": "CDK app for deploying serverless cyber sage",
  "private": true,
  "scripts": {
    "build": "cargo lambda build --locked --release --manifest-path s-cybersage-rs/Cargo.toml",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "format": "prettier --write . && cargo fmt --manifest-path s-cybersage-rs/Cargo.toml",
    "format:check": "prettier --check . && cargo fmt --check --manifest-path s-cybersage-rs/Cargo.toml",
    "lint": "npm run lint:ts && npm run lint:rust",
    "lint:ts": "eslint . --max-warnings=0",
    "lint:rust": "cargo clippy --locked --manifest-path s-cybersage-rs/Cargo.toml --all-targets -- -D warnings",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:ts && npm run test:rust",
    "test:ts": "vitest run --configLoader runner",
    "test:rust": "cargo test --locked --manifest-path s-cybersage-rs/Cargo.toml",
    "coverage": "npm run coverage:ts && npm run coverage:rust",
    "coverage:ts": "vitest run --configLoader runner --coverage",
    "coverage:rust": "cargo llvm-cov --locked --manifest-path s-cybersage-rs/Cargo.toml --lcov --output-path coverage/rust.lcov --ignore-filename-regex '(^|/)(app_context|http_handler|lib|main)\\.rs$|/infrastructure/' --fail-under-lines 90",
    "infra:validate": "npm run build && cdk synth",
    "audit": "npm audit --omit=dev",
    "predeploy": "npm run build",
    "deploy": "bash -c 'cdk deploy --all \"$@\"' --",
    "register-commands": "tsx commands/register-commands.ts"
  },
  "dependencies": {
    "@discordjs/rest": "^0.4.1",
    "aws-cdk-lib": "^2.239.0",
    "constructs": "^10.5.1",
    "discord-api-types": "^0.38.25",
    "dotenv": "^17.2.2",
    "source-map-support": "^0.5.21"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "@vitest/coverage-v8": "4.1.10",
    "aws-cdk": "^2.239.0",
    "cdk-nag": "^2.37.13",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^50.6.17",
    "prettier": "^3.6.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.2",
    "vitest": "4.1.10"
  }
}
